# Logto 单页应用的 App ID；留空时隐藏登录入口。
VITE_LOGTO_APP_ID=

# Logto 服务地址，未设置时默认使用 https://auth.cqaiclub.asia。
VITE_LOGTO_ENDPOINT=https://auth.cqaiclub.asia

# Logto API Resource；与 Account Service 的 LOGTO_AUDIENCE 保持一致。
VITE_LOGTO_API_RESOURCE=

# 申请 Access Token 时请求的权限，多个权限用空格或逗号分隔。
VITE_LOGTO_API_SCOPES=ai:invoke

# CQAI Account Service 公网地址；与 VITE_LOGTO_API_RESOURCE 一起配置后启用账号服务模式。
VITE_ACCOUNT_SERVICE_URL=

# NewAPI 控制台地址；账户菜单中的额度查看和充值入口会跳转到这里。
VITE_NEW_API_URL=https://relay.cqaiclub.asia

# 可选的远程提示词索引地址；留空时使用构建产物内的 prompt-library/index.json。
VITE_PROMPT_LIBRARY_URL=
